#!/usr/bin/env bash
# `code`: start (or reuse) this directory's TUI server and mount the board. All the logic
# lives in src/launcher.ts; this file only checks that bun exists and execs it.
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if ! command -v bun >/dev/null 2>&1; then
  echo "code-tui: bun is not on PATH" >&2
  exit 1
fi
exec bun "$ROOT/src/launcher.ts" "$@"
